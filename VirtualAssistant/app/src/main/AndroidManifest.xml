<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vnsolution.virtualassistant">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".VirtualAssistantApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Meta Data -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBQr8YzGqe0PWQiEMx9JbsnXmbpRZvQURo" />

        <!-- Screens -->
        <activity
            android:name=".ui.StartupActivity"
            android:noHistory="true"
            android:theme="@style/AppTheme.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.home.HomeV2Activity"
            android:label="@string/title_screen_home" />
        <activity
            android:name=".ui.travel.TravelV2Activity"
            android:label="@string/title_screen_travel_dashboard" />
        <activity
            android:name=".ui.travel.TravelDashboardActivity"
            android:label="@string/title_screen_travel_dashboard" />
        <activity
            android:name=".ui.travel.TravelHistoryActivity"
            android:label="@string/title_screen_travel_history" />
        <activity
            android:name=".ui.travel.TravelViewActivity"
            android:label="@string/title_screen_travel_view" />
        <activity
            android:name=".ui.travel.TravelEditActivity"
            android:label="@string/title_screen_travel_edit" />
        <activity
            android:name=".ui.contact.ContactDashboardActivity"
            android:label="@string/title_screen_contacts"/>
        <activity
            android:name=".ui.contact.ContactViewActivity"
            android:label="@string/title_screen_contacts"/>
        <activity
            android:name=".ui.contact.ContactListActivity"
            android:label="@string/title_screen_contacts"/>
        <activity
            android:name=".ui.phoneapp.PhoneAppDashboardActivity"
            android:label="@string/title_screen_applications" />
        <activity
            android:name=".ui.reminder.ReminderListActivity"
            android:label="@string/title_screen_reminders" />
        <activity
            android:name=".ui.reminder.ReminderNewActivity"
            android:label="@string/title_screen_reminders" />
        <activity
            android:name=".ui.reminder.ReminderShowFullScreenActivity"
            android:label="@string/title_screen_reminders" />
        <activity android:name=".ui.phoneapp.v1.PhoneAppActivity" />
        <activity android:name=".ui.phoneapp.v2.PhoneAppV2Activity" />
        <activity
            android:name=".ui.phonecall.v1.PhoneCallActivity"
            android:label="@string/title_screen_call_history"/>
        <activity
            android:name=".ui.phonesms.v1.PhoneSmsActivity"
            android:label="@string/title_screen_sms_history"/>
        <activity
            android:name=".ui.setting.SettingActivity"
            android:label="@string/title_screen_settings" />

        <!-- Services -->
        <service
            android:name=".service.stoptracking.StopTrackingService"
            android:exported="true" />
        <service
            android:name=".service.device.DeviceService"
            android:exported="true" />
        <service
            android:name=".service.stoptracking.ActivityTransitionsJobIntentService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".service.stoptracking.GeofenceTransitionsJobIntentService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".service.bubble.FloatingViewService" />

        <!-- Broadcast Receivers -->
        <receiver
            android:name=".startup.StartupBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".service.stoptracking.ActivityTransitionBroadcastReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.permission.ACTIVITY_RECOGNITION">
            <intent-filter>
                <action android:name="com.vnsolution.virtualassistant.ACTION_PROCESS_ACTIVITY_TRANSITIONS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".service.stoptracking.GeofenceBroadcastReceiver"
            android:exported="true" />
        <receiver
            android:name=".service.stoptracking.LocationUpdatesBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vnsolution.virtualassistant.ACTION_UPDATE_LOCATIONS" />
            </intent-filter>
        </receiver>
        <receiver android:name=".service.device.PhoneCallReceiver">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>
        <receiver android:name=".service.device.PhoneSmsReceiver">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".service.reminder.ReminderBroadcastReceiver"
            android:exported="true" />

    </application>

</manifest>