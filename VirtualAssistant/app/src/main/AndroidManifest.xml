<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vnsolution.virtualassistant">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <application
        android:name="com.vnsolution.virtualassistant.VirtualAssistantApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Meta Data -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBQr8YzGqe0PWQiEMx9JbsnXmbpRZvQURo" />

        <!-- Screens -->
        <activity
            android:name="com.vnsolution.virtualassistant.ui.HomeV2Activity"
            android:label="@string/title_screen_home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.vnsolution.virtualassistant.ui.developer.DeveloperActivity" />
        <activity
            android:name="com.vnsolution.virtualassistant.ui.travel.TravelV2Activity"
            android:label="@string/title_screen_travel_dashboard" />
        <activity
            android:name="com.vnsolution.virtualassistant.ui.travel.TravelDashboardActivity"
            android:label="@string/title_screen_travel_dashboard"/>
        <activity
            android:name="com.vnsolution.virtualassistant.ui.travel.TravelHistoryActivity"
            android:label="@string/title_activity_travel_history" />
        <activity
            android:name="com.vnsolution.virtualassistant.ui.travel.TravelViewActivity"
            android:label="@string/title_activity_travel_view" />
        <activity
            android:name="com.vnsolution.virtualassistant.ui.travel.TravelEditActivity"
            android:label="@string/title_activity_travel_edit" />
        <activity android:name="com.vnsolution.virtualassistant.ui.phoneapps.v1.PhoneAppsActivity" />
        <activity android:name="com.vnsolution.virtualassistant.ui.phoneapps.v2.PhoneAppsV2Activity" />
        <activity android:name="com.vnsolution.virtualassistant.ui.phonecalls.v1.PhoneCallsActivity" />
        <activity android:name="com.vnsolution.virtualassistant.ui.phonesms.v1.PhoneSmsActivity" />
        <activity android:name="com.vnsolution.virtualassistant.ui.phonecontacts.PhoneContactsActivity" />
        <activity android:name="com.vnsolution.virtualassistant.ui.settings.SettingsActivity" />

        <!-- Services -->
        <service
            android:name="com.vnsolution.virtualassistant.service.stop_tracking.StopTrackingService"
            android:exported="true" />
        <service
            android:name="com.vnsolution.virtualassistant.service.stop_tracking.ActivityTransitionsJobIntentService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="com.vnsolution.virtualassistant.service.stop_tracking.GeofenceTransitionsJobIntentService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Broadcast Receivers -->
        <receiver
            android:name="com.vnsolution.virtualassistant.startup.StartupBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.vnsolution.virtualassistant.service.stop_tracking.ActivityTransitionBroadcastReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.permission.ACTIVITY_RECOGNITION">
            <intent-filter>
                <action android:name="com.vnsolution.virtualassistant.ACTION_PROCESS_ACTIVITY_TRANSITIONS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.vnsolution.virtualassistant.service.stop_tracking.GeofenceBroadcastReceiver"
            android:exported="true" />
        <receiver
            android:name="com.vnsolution.virtualassistant.service.stop_tracking.LocationUpdatesBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vnsolution.virtualassistant.ACTION_UPDATE_LOCATIONS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>