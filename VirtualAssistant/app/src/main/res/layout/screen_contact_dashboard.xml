<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ActionBar -->
    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Recent calls"
                android:textColor="@color/color_black"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_recent_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Most calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_most_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_most_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <include layout="@layout/card_contact_stat" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Recent incoming calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_incoming_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_recent_incoming_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no incoming call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Most incoming calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_most_incoming_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_most_incoming_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no incoming call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Recent outgoing calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_outgoing_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_recent_outgoing_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no outgoing call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Most outgoing calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_most_outgoing_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_most_outgoing_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no outgoing call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Recent missed calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_missed_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_missed_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no missed call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Recent rejected calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_rejected_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_recent_rejected_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no rejected call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="Recent blocked calls"
                android:textColor="@color/color_black"
                android:layout_marginTop="40dp"
                android:textStyle="bold"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent_blocked_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/no_recent_blocked_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="There is no blocked call"
                android:textColor="@color/color_black"
                android:textStyle="italic"
                android:visibility="gone"
                />

        </LinearLayout>

    </ScrollView>

</LinearLayout>