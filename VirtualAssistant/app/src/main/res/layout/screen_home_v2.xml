<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/iv_voice_assistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="How can I help you?" />

    <Button
        android:id="@+id/btn_visited_places"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show visited places" />

    <Button
        android:id="@+id/btn_installed_applications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show installed applications" />

    <Button
        android:id="@+id/btn_call_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show call logs" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show settings"
        tools:layout_editor_absoluteX="157dp"
        tools:layout_editor_absoluteY="59dp" />
</LinearLayout>