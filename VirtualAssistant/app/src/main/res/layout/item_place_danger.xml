<?xml version="1.0" encoding="utf-8"?>
<vn.sttechnology.virtualassistant.ui.travel.component.PlaceDangerSimpleRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <ImageView
        android:src="@drawable/ic_baseline_coronavirus_24"
        android:layout_width="40dp"
        android:layout_height="40dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="15dp">

        <TextView
            android:id="@+id/danger_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/updated_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </LinearLayout>

</vn.sttechnology.virtualassistant.ui.travel.component.PlaceDangerSimpleRow>