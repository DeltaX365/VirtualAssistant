<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomsheet_app_dashboard_filter_options"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    app:behavior_hideable="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filter"
                android:textSize="18sp"
                android:paddingLeft="10dp"
                android:textColor="@color/color_black"
                />
            <TextView
                android:id="@+id/accept_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK"
                android:textSize="16sp"
                android:textColor="@color/color_black"
                />

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="10dp"
            />
        <RadioGroup
            android:id="@+id/app_dashboard_filter"
            android:checkedButton="@+id/app_dashboard_filter_exclude_system_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/app_dashboard_filter_exclude_system_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exclude system apps"
                />
            <RadioButton
                android:id="@+id/app_dashboard_filter_include_system_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Include system apps"
                />

        </RadioGroup>

    </LinearLayout>

</LinearLayout>