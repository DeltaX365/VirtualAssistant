<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <Button
        android:id="@+id/btn_visited_places"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show visited places" />

    <Button
        android:id="@+id/btn_manual_check_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manual check in" />

    <Button
        android:id="@+id/btn_manual_check_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manual check out" />

    <Button
        android:id="@+id/btn_installed_applications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show installed applications" />

    <Button
        android:id="@+id/btn_call_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show call logs" />

    <Button
        android:id="@+id/btn_sms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show phoneSms" />

    <Button
        android:id="@+id/btn_contacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show phoneContacts" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show settings" />

</LinearLayout>