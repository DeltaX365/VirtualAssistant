<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomsheet_reminder_repeat_options"
    android:background="@color/color_grey"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    app:behavior_hideable="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="Repeat Options"
                android:textColor="@color/color_white"
                android:layout_gravity="center_vertical"
                />
            <ImageButton
                android:id="@+id/reminder_repeat_option_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_close_24"
                android:background="@color/color_white"
                />

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="20dp"
            />
        <RadioGroup
            android:id="@+id/reminder_repeat_option_group"
            android:checkedButton="@+id/reminder_repeat_option_no_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <RadioButton
                android:id="@+id/reminder_repeat_option_no_repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No repeat"
                android:textColor="@color/color_white"
                />
            <RadioButton
                android:id="@+id/reminder_repeat_option_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily"
                android:textColor="@color/color_white"
                />
            <RadioButton
                android:id="@+id/reminder_repeat_option_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weekly"
                android:textColor="@color/color_white"
                />
            <RadioButton
                android:id="@+id/reminder_repeat_option_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly"
                android:textColor="@color/color_white"
                />
            <RadioButton
                android:id="@+id/reminder_repeat_option_yearly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yearly"
                android:textColor="@color/color_white"
                />
            
        </RadioGroup>

    </LinearLayout>

</LinearLayout>