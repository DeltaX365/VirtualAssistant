<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.vnsolution.virtualassistant.ui.dashboard.DashboardFragment"
        android:label="@string/title_screen_dashboard"
        tools:layout="@layout/screen_dashboard" />

    <fragment
        android:id="@+id/navigation_places"
        android:name="com.vnsolution.virtualassistant.ui.travel.TravelFragment"
        android:label="@string/title_screen_travel_dashboard"
        tools:layout="@layout/screen_travel_dashboard" />

    <fragment
        android:id="@+id/navigation_apps"
        android:name="com.vnsolution.virtualassistant.ui.phoneapp.v1.PhoneAppsFragment"
        android:label="@string/title_screen_applications"
        tools:layout="@layout/screen_app" />

    <fragment
        android:id="@+id/navigation_call_logs"
        android:name="com.vnsolution.virtualassistant.ui.phonecall.v1.CallLogsFragment"
        android:label="@string/title_screen_call_history"
        tools:layout="@layout/screen_phone_call" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.vnsolution.virtualassistant.ui.setting.SettingFragment"
        android:label="@string/title_screen_settings"
        tools:layout="@layout/screen_setting" />
</navigation>
