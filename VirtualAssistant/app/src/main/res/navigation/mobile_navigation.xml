<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.vnsolution.virtualassistant.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/screen_dashboard" />

    <fragment
        android:id="@+id/navigation_places"
        android:name="com.vnsolution.virtualassistant.ui.places.v1.VisitedPlacesFragment"
        android:label="@string/title_places"
        tools:layout="@layout/screen_visited_places" />

    <fragment
        android:id="@+id/navigation_apps"
        android:name="com.vnsolution.virtualassistant.ui.applications.InstalledApplicationsFragment"
        android:label="@string/title_applications"
        tools:layout="@layout/screen_installed_applications" />

    <fragment
        android:id="@+id/navigation_call_logs"
        android:name="com.vnsolution.virtualassistant.ui.calllogs.CallLogsFragment"
        android:label="@string/title_call_logs"
        tools:layout="@layout/screen_call_logs" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.vnsolution.virtualassistant.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/screen_settings" />
</navigation>
