<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="vn.sttechnology.virtualassistant.ui.dashboard.DashboardFragment"
        android:label="@string/screen_dashboard"
        tools:layout="@layout/screen_dashboard" />

    <fragment
        android:id="@+id/navigation_places"
        android:name="vn.sttechnology.virtualassistant.ui.travel.TravelFragment"
        android:label="@string/screen_travels"
        tools:layout="@layout/screen_travel_dashboard" />

    <fragment
        android:id="@+id/navigation_apps"
        android:name="vn.sttechnology.virtualassistant.ui.apps.v1.PhoneAppsFragment"
        android:label="@string/screen_apps"
        tools:layout="@layout/screen_app_list" />

    <fragment
        android:id="@+id/navigation_call_logs"
        android:name="vn.sttechnology.virtualassistant.ui.phonecall.v1.CallLogsFragment"
        android:label="@string/screen_call_logs"
        tools:layout="@layout/screen_phone_call_list" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="vn.sttechnology.virtualassistant.ui.settings.SettingFragment"
        android:label="@string/screen_settings"
        tools:layout="@layout/screen_setting" />
</navigation>
